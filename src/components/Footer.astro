---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner label">
    <span>©{year} {site.name}</span>
    <span>Designed by me, built with Claude Code</span>
    <button class="top" type="button" data-to-top>top <span aria-hidden="true">↑</span></button>
  </div>
</footer>

<script>
  /* "top": glide back to the start of the page (with Lenis when it's on,
     otherwise the browser's own scroll). */
  import { lenis } from '../scripts/smooth-scroll';

  document.addEventListener('astro:page-load', () => {
    document.querySelector('[data-to-top]')?.addEventListener('click', () => {
      if (lenis) lenis.scrollTo(0, { duration: 1.2 });
      else window.scrollTo({ top: 0 });
    });
  });
</script>

<style>
  .inner {
    max-width: calc(var(--measure) + var(--gutter) * 2);
    margin-inline: auto;
    padding: var(--space-6) var(--gutter) var(--space-7);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    color: var(--color-text-faint);
  }
  .top {
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    transition: color var(--duration-base) var(--ease-out);
  }
  .top span {
    display: inline-block;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .top:hover {
    color: var(--color-text);
  }
  .top:hover span {
    transform: translateY(-3px);
  }
</style>
