---
/* A labelled section on the index ("work", "experience", "contact"). */
interface Props {
  label: string;
  id?: string;
}
const { label, id } = Astro.props;
const headingId = `${id ?? label}-heading`;
import LedSeparator from './LedSeparator.astro';
---

<section class="section" aria-labelledby={headingId} id={id}>
  <h2 class="label" id={headingId} data-reveal>{label}</h2>
  <LedSeparator />
  <slot />
</section>

<style>
  .section {
    margin-top: var(--space-8);
  }
  h2 {
    font-weight: var(--weight-regular);
    margin-bottom: var(--space-2);
  }
</style>
