---
/* Homepage background: one oversized Mir-i-Arab portal and dome, softly
   abstracted and dithered into a single repeated mark (like a halftone
   poster), with a slow band of light sweeping across it.

   - Art comes from src/data/ascii-art.ts (generated by `npm run ascii`).
   - Strength, colour and timing are tokens (--ascii-* in tokens.css).
   - Decorative only: hidden from screen readers.
   - Reduced motion: drawn once, no sweep. Paused while the tab is hidden. */
---

<canvas class="ascii-bg" data-ascii-bg aria-hidden="true"></canvas>

<script>
  import { asciiArt } from '../data/ascii-art';

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const FPS = 30; // plenty for a slow sweep, half the work of 60
  const BAND = 0.28; // width of the light band, as a share of the art width
  const MIN_CELL = 3; // px — smallest mark spacing (phones)
  const FOCUS_X = 0.775; // where to centre when the art is wider than the screen (Mir-i-Arab)
  // 1 bit per cell, row-major (see scripts/ascii-art.mjs).
  const bits = Uint8Array.from(atob(asciiArt.bits), (c) => c.charCodeAt(0));
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

  const setup = () => {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-ascii-bg]');
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;

    // Two offscreen layers: the art itself, and a scratch layer for the band.
    const art = document.createElement('canvas');
    const glow = document.createElement('canvas');
    const artCtx = art.getContext('2d')!;
    const glowCtx = glow.getContext('2d')!;

    let tokens = { color: '#888', base: 0.08, peak: 0.16, period: 24000 };
    let box = { x: 0, y: 0, w: 0, h: 0 }; // where the art sits on the canvas
    let raf = 0;
    let last = 0;
    let start = performance.now();

    const readTokens = () => {
      const css = getComputedStyle(document.documentElement);
      tokens = {
        color: css.getPropertyValue('--ascii-color').trim() || '#888',
        base: parseFloat(css.getPropertyValue('--ascii-opacity')) || 0.08,
        peak: parseFloat(css.getPropertyValue('--ascii-opacity-peak')) || 0.16,
        period: (parseFloat(css.getPropertyValue('--ascii-pass-duration')) || 24) * 1000,
      };
    };

    // Draw every symbol once into the offscreen `art` canvas. Per frame we
    // only composite this image, never re-draw text.
    const renderArt = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      canvas.width = glow.width = Math.round(vw * dpr);
      canvas.height = glow.height = Math.round(vh * dpr);

      // Edge to edge: the grid spans the full window width, anchored to the
      // bottom (on short windows the airy top is what gets cut off).
      // On phones the marks keep a minimum size and the view centres on the
      // portal instead of shrinking the whole monument.
      const cell = Math.max(vw / asciiArt.cols, MIN_CELL) * dpr;
      box = { w: asciiArt.cols * cell, h: asciiArt.rows * cell, x: 0, y: 0 };
      const overflow = box.w - canvas.width; // 0 on desktop
      box.x = -Math.round(clamp(box.w * FOCUS_X - canvas.width / 2, 0, overflow));
      box.y = Math.round(canvas.height - box.h);

      art.width = Math.ceil(box.w);
      art.height = Math.ceil(box.h);
      artCtx.setTransform(1, 0, 0, 1, 0, 0);
      artCtx.fillStyle = tokens.color;

      // The mark: a small '+' drawn with two rectangles, snapped to whole
      // device pixels so it stays crisp at any size.
      const arm = Math.max(1, Math.round(cell * 0.7));
      const stroke = Math.max(1, Math.round(cell * 0.18));
      const inset = Math.round((cell - arm) / 2);
      const mid = Math.round((cell - stroke) / 2);
      for (let row = 0; row < asciiArt.rows; row++) {
        for (let col = 0; col < asciiArt.cols; col++) {
          const i = row * asciiArt.cols + col;
          if (!((bits[i >> 3] >> (i & 7)) & 1)) continue;
          const x = Math.round(col * cell);
          const y = Math.round(row * cell);
          artCtx.fillRect(x + inset, y + mid, arm, stroke);
          artCtx.fillRect(x + mid, y + inset, stroke, arm);
        }
      }
    };

    const draw = (now: number) => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      // Nothing to draw yet (e.g. window has no size in a hidden tab/iframe).
      if (!art.width || !art.height || !canvas.width || !canvas.height) return;

      // Resting layer.
      ctx.globalAlpha = tokens.base;
      ctx.drawImage(art, box.x, box.y);

      if (reduceMotion.matches) return;

      // Light pass: the band crosses in the first 60% of the period, then
      // rests off-screen. Eased so it drifts in and out rather than sliding.
      const t = ((now - start) % tokens.period) / tokens.period;
      const p = Math.min(1, t / 0.6);
      const eased = p < 0.5 ? 2 * p * p : 1 - (-2 * p + 2) ** 2 / 2;
      const span = box.w * (1 + BAND * 2);
      const center = box.x - box.w * BAND + span * eased;
      const half = box.w * BAND;

      glowCtx.globalCompositeOperation = 'source-over';
      glowCtx.clearRect(0, 0, glow.width, glow.height);
      glowCtx.drawImage(art, box.x, box.y);
      // Keep only the part of the art under a soft, slightly tilted band.
      glowCtx.globalCompositeOperation = 'destination-in';
      const tilt = box.h * 0.35;
      const g = glowCtx.createLinearGradient(
        center - half - tilt, box.y,
        center + half + tilt, box.y + box.h
      );
      g.addColorStop(0, 'rgba(0,0,0,0)');
      g.addColorStop(0.5, 'rgba(0,0,0,1)');
      g.addColorStop(1, 'rgba(0,0,0,0)');
      glowCtx.fillStyle = g;
      glowCtx.fillRect(0, 0, glow.width, glow.height);

      ctx.globalAlpha = Math.max(0, tokens.peak - tokens.base);
      ctx.drawImage(glow, 0, 0);
    };

    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      if (now - last < 1000 / FPS) return;
      last = now;
      draw(now);
    };

    const play = () => {
      cancelAnimationFrame(raf);
      if (reduceMotion.matches || document.hidden) {
        draw(performance.now());
        return;
      }
      raf = requestAnimationFrame(loop);
    };

    const refresh = () => {
      readTokens();
      renderArt();
      play();
    };

    // Re-render on resize (debounced), theme change, and motion preference.
    let resizeTimer = 0;
    const onResize = () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(refresh, 150);
    };
    const themeObserver = new MutationObserver(refresh);
    themeObserver.observe(document.documentElement, { attributeFilter: ['data-theme'] });
    const darkQuery = matchMedia('(prefers-color-scheme: dark)');

    window.addEventListener('resize', onResize);
    document.addEventListener('visibilitychange', play);
    darkQuery.addEventListener('change', refresh);
    reduceMotion.addEventListener('change', play);

    // Leaving the homepage: stop the loop and drop every listener.
    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelAnimationFrame(raf);
        clearTimeout(resizeTimer);
        themeObserver.disconnect();
        window.removeEventListener('resize', onResize);
        document.removeEventListener('visibilitychange', play);
        darkQuery.removeEventListener('change', refresh);
        reduceMotion.removeEventListener('change', play);
      },
      { once: true }
    );

    // Wait for Geist Mono, otherwise the first frame uses a fallback font.
    const family = getComputedStyle(document.documentElement).getPropertyValue('--font-mono');
    document.fonts
      .load(`16px ${family}`)
      .catch(() => {})
      .finally(() => {
        start = performance.now();
        refresh();
        canvas.classList.add('is-ready');
      });
  };

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .ascii-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Behind all content, above the page background. */
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .ascii-bg.is-ready {
    opacity: 1;
  }
</style>
