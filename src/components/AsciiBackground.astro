---
/* Homepage background: a landscape of Bukhara's old city (Mir-i-Arab, the
   Kalyan minaret, domes and rooftops), dithered into a single repeated mark.

   Two stacked layers:
   - `.art`   the illustration, drawn once and completely static.
   - `.light` an identical copy, seen only through a soft gradient mask that
              travels left → right on a loop, so the marks underneath brighten
              slightly as it passes, like a very wide, soft spotlight.
   The movement is pure CSS (the mask moves; nothing is redrawn).

   - Art comes from src/data/ascii-art.ts (generated by `npm run ascii`).
   - Strength, colour, speed and light width are tokens (--ascii-* in tokens.css).
   - Decorative only: hidden from screen readers.
   - Reduced motion: the light layer is removed; the art stays. */
---

<div class="ascii-bg" data-ascii-bg aria-hidden="true">
  <canvas class="art" data-ascii-art></canvas>
  <canvas class="light" data-ascii-light></canvas>
</div>

<script>
  import { asciiArt } from '../data/ascii-art';

  const MIN_CELL = 3; // px — smallest mark spacing (phones)
  const FOCUS_X = 0.775; // where to centre when the art is wider than the screen (Mir-i-Arab)
  // 1 bit per cell, row-major (see scripts/ascii-art.mjs).
  const bits = Uint8Array.from(atob(asciiArt.bits), (c) => c.charCodeAt(0));
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

  const setup = () => {
    const root = document.querySelector<HTMLElement>('[data-ascii-bg]');
    const art = document.querySelector<HTMLCanvasElement>('[data-ascii-art]');
    const light = document.querySelector<HTMLCanvasElement>('[data-ascii-light]');
    if (!root || !art || !light) return;
    const artCtx = art.getContext('2d')!;
    const lightCtx = light.getContext('2d')!;

    // Draw every mark once. Called again only on resize or theme change.
    const render = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      if (!vw || !vh) return; // no size yet (e.g. hidden tab)
      art.width = light.width = Math.round(vw * dpr);
      art.height = light.height = Math.round(vh * dpr);

      // Edge to edge: the grid spans the full window width, anchored to the
      // bottom (on short windows the empty sky is what gets cut off).
      // On phones the marks keep a minimum size and the view centres on
      // Mir-i-Arab instead of shrinking the whole landscape.
      const cell = Math.max(vw / asciiArt.cols, MIN_CELL) * dpr;
      const w = asciiArt.cols * cell;
      const h = asciiArt.rows * cell;
      const x0 = -Math.round(clamp(w * FOCUS_X - art.width / 2, 0, w - art.width));
      const y0 = Math.round(art.height - h);

      // The mark: a small '+' drawn with two rectangles, snapped to whole
      // device pixels so it stays crisp at any size.
      const arm = Math.max(1, Math.round(cell * 0.7));
      const stroke = Math.max(1, Math.round(cell * 0.18));
      const inset = Math.round((cell - arm) / 2);
      const mid = Math.round((cell - stroke) / 2);

      artCtx.clearRect(0, 0, art.width, art.height);
      artCtx.fillStyle = getComputedStyle(document.documentElement)
        .getPropertyValue('--ascii-color')
        .trim();
      for (let row = 0; row < asciiArt.rows; row++) {
        for (let col = 0; col < asciiArt.cols; col++) {
          const i = row * asciiArt.cols + col;
          if (!((bits[i >> 3] >> (i & 7)) & 1)) continue;
          const x = x0 + Math.round(col * cell);
          const y = y0 + Math.round(row * cell);
          artCtx.fillRect(x + inset, y + mid, arm, stroke);
          artCtx.fillRect(x + mid, y + inset, stroke, arm);
        }
      }

      // The light layer is an exact copy; CSS decides what part shows.
      lightCtx.clearRect(0, 0, light.width, light.height);
      lightCtx.drawImage(art, 0, 0);
    };

    // Re-render on resize (debounced) and theme change.
    let resizeTimer = 0;
    const onResize = () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(render, 150);
    };
    const themeObserver = new MutationObserver(render);
    themeObserver.observe(document.documentElement, { attributeFilter: ['data-theme'] });
    const darkQuery = matchMedia('(prefers-color-scheme: dark)');

    window.addEventListener('resize', onResize);
    darkQuery.addEventListener('change', render);

    // Leaving the homepage: drop every listener.
    document.addEventListener(
      'astro:before-swap',
      () => {
        clearTimeout(resizeTimer);
        themeObserver.disconnect();
        window.removeEventListener('resize', onResize);
        darkQuery.removeEventListener('change', render);
      },
      { once: true }
    );

    render();
    root.classList.add('is-ready');
  };

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .ascii-bg {
    position: fixed;
    inset: 0;
    /* Behind all content, above the page background. */
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .ascii-bg.is-ready {
    opacity: 1;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .art {
    opacity: var(--ascii-opacity);
  }

  /* The moving light: a copy of the art behind a soft gradient mask.
     The mask is one band (--ascii-light-width wide) that starts fully off
     the left edge and travels until it's fully off the right, then loops —
     so the restart is invisible. Linear, with no hard edges. */
  .light {
    opacity: calc(var(--ascii-opacity-peak) - var(--ascii-opacity));
    --band: linear-gradient(
      90deg,
      transparent 0%,
      rgb(0 0 0 / 0.08) 15%,
      rgb(0 0 0 / 0.35) 30%,
      rgb(0 0 0 / 0.8) 43%,
      #000 50%,
      rgb(0 0 0 / 0.8) 57%,
      rgb(0 0 0 / 0.35) 70%,
      rgb(0 0 0 / 0.08) 85%,
      transparent 100%
    );
    -webkit-mask-image: var(--band);
    mask-image: var(--band);
    -webkit-mask-size: var(--ascii-light-width) 100%;
    mask-size: var(--ascii-light-width) 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: ascii-light var(--ascii-pass-duration) linear infinite;
  }

  @keyframes ascii-light {
    from {
      -webkit-mask-position: calc(var(--ascii-light-width) * -1) 0;
      mask-position: calc(var(--ascii-light-width) * -1) 0;
    }
    to {
      -webkit-mask-position: 100vw 0;
      mask-position: 100vw 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .light {
      display: none;
    }
  }
</style>
