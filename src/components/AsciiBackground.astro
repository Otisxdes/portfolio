---
/* Homepage background: a landscape of Bukhara's old city (Mir-i-Arab, the
   Kalyan minaret, domes and rooftops), dithered into a single repeated mark.

   Two stacked layers:
   - `.art`     the illustration, drawn once and completely static.
   - `.twinkle` a transparent layer where a few of the existing marks, at a
                time, softly brighten and fade back — like light catching
                different parts of the architecture. It only ever redraws
                marks that are already there, in the same place and shape.

   - Art comes from src/data/ascii-art.ts (generated by `npm run ascii`).
   - Strength and twinkle are tokens (--ascii-* in tokens.css).
   - Decorative only: hidden from screen readers.
   - Reduced motion: no twinkle. Paused while the tab is hidden. */
---

<div class="ascii-bg" data-ascii-bg aria-hidden="true">
  <canvas class="art" data-ascii-art></canvas>
  <canvas class="twinkle" data-ascii-twinkle></canvas>
</div>

<script>
  import { asciiArt } from '../data/ascii-art';

  const MIN_CELL = 3; // px — smallest mark spacing (phones)
  const FOCUS_X = 0.775; // where to centre when the art is wider than the screen (Mir-i-Arab)
  const FPS = 30; // plenty for slow fades
  const FADE = [1500, 3000]; // ms — each twinkle's full fade in + out
  const STRENGTH = [0.6, 1]; // × --ascii-twinkle-peak, varied per twinkle
  // 1 bit per cell, row-major (see scripts/ascii-art.mjs).
  const bits = Uint8Array.from(atob(asciiArt.bits), (c) => c.charCodeAt(0));
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
  const between = ([a, b]: number[]) => a + Math.random() * (b - a);

  type Twinkle = { x: number; y: number; start: number; duration: number; strength: number };

  const setup = () => {
    const root = document.querySelector<HTMLElement>('[data-ascii-bg]');
    const art = document.querySelector<HTMLCanvasElement>('[data-ascii-art]');
    const glint = document.querySelector<HTMLCanvasElement>('[data-ascii-twinkle]');
    if (!root || !art || !glint) return;
    const artCtx = art.getContext('2d')!;
    const glintCtx = glint.getContext('2d')!;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

    // Positions of every visible mark (device px), filled in by render().
    let marks: Array<[number, number]> = [];
    let mark = { arm: 1, stroke: 1, inset: 0, mid: 0 };
    let color = '#888';
    let peak = 0.4; // extra opacity at a twinkle's brightest
    let density = 0.005; // share of marks lit at any moment

    let twinkles: Twinkle[] = [];
    let raf = 0;
    let last = 0;

    const drawMark = (ctx: CanvasRenderingContext2D, x: number, y: number) => {
      ctx.fillRect(x + mark.inset, y + mark.mid, mark.arm, mark.stroke);
      ctx.fillRect(x + mark.mid, y + mark.inset, mark.stroke, mark.arm);
    };

    // Draw every mark once. Called again only on resize or theme change.
    const render = () => {
      const css = getComputedStyle(document.documentElement);
      color = css.getPropertyValue('--ascii-color').trim();
      peak = parseFloat(css.getPropertyValue('--ascii-twinkle-peak')) || 0.4;
      density = parseFloat(css.getPropertyValue('--ascii-twinkle-density')) || 0.005;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      if (!vw || !vh) return; // no size yet (e.g. hidden tab)
      art.width = glint.width = Math.round(vw * dpr);
      art.height = glint.height = Math.round(vh * dpr);

      // Edge to edge: the grid spans the full window width, anchored to the
      // bottom (on short windows the empty sky is what gets cut off).
      // On phones the marks keep a minimum size and the view centres on
      // Mir-i-Arab instead of shrinking the whole landscape.
      const cell = Math.max(vw / asciiArt.cols, MIN_CELL) * dpr;
      const w = asciiArt.cols * cell;
      const h = asciiArt.rows * cell;
      const x0 = -Math.round(clamp(w * FOCUS_X - art.width / 2, 0, w - art.width));
      const y0 = Math.round(art.height - h);

      // The mark: a small '+' drawn with two rectangles, snapped to whole
      // device pixels so it stays crisp at any size.
      const arm = Math.max(1, Math.round(cell * 0.7));
      const stroke = Math.max(1, Math.round(cell * 0.18));
      mark = { arm, stroke, inset: Math.round((cell - arm) / 2), mid: Math.round((cell - stroke) / 2) };

      artCtx.clearRect(0, 0, art.width, art.height);
      artCtx.fillStyle = color;
      marks = [];
      for (let row = 0; row < asciiArt.rows; row++) {
        for (let col = 0; col < asciiArt.cols; col++) {
          const i = row * asciiArt.cols + col;
          if (!((bits[i >> 3] >> (i & 7)) & 1)) continue;
          const x = x0 + Math.round(col * cell);
          const y = y0 + Math.round(row * cell);
          drawMark(artCtx, x, y);
          if (x > -cell && x < art.width && y > -cell && y < art.height) marks.push([x, y]);
        }
      }
      twinkles = []; // positions changed; start fresh
    };

    // Twinkle loop: keep roughly `density` of the marks lit. New twinkles
    // start at random moments (so pauses are irregular), each with its own
    // length and strength, and fade in and out on a smooth curve.
    const frame = (now: number) => {
      glintCtx.clearRect(0, 0, glint.width, glint.height);
      twinkles = twinkles.filter((t) => now - t.start < t.duration);

      const target = Math.max(1, Math.round(marks.length * density));
      // Spawn chance per frame tuned so the average stays near `target`.
      const avgLife = (FADE[0] + FADE[1]) / 2;
      const perFrame = (target * (1000 / FPS)) / avgLife;
      let spawn = Math.floor(perFrame) + (Math.random() < perFrame % 1 ? 1 : 0);
      while (spawn-- > 0 && marks.length && twinkles.length < target * 1.5) {
        const [x, y] = marks[Math.floor(Math.random() * marks.length)];
        twinkles.push({ x, y, start: now, duration: between(FADE), strength: between(STRENGTH) });
      }

      glintCtx.fillStyle = color;
      for (const t of twinkles) {
        const p = (now - t.start) / t.duration; // 0 → 1
        const ease = Math.sin(Math.PI * p) ** 2; // soft in, soft out
        glintCtx.globalAlpha = peak * t.strength * ease;
        drawMark(glintCtx, t.x, t.y);
      }
      glintCtx.globalAlpha = 1;
    };

    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      if (now - last < 1000 / FPS) return;
      last = now;
      frame(now);
    };

    const play = () => {
      cancelAnimationFrame(raf);
      glintCtx.clearRect(0, 0, glint.width, glint.height);
      twinkles = [];
      if (reduceMotion.matches || document.hidden) return;
      raf = requestAnimationFrame(loop);
    };

    const refresh = () => {
      render();
      play();
    };

    // Re-render on resize (debounced), theme change, and motion preference.
    let resizeTimer = 0;
    const onResize = () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(refresh, 150);
    };
    const themeObserver = new MutationObserver(refresh);
    themeObserver.observe(document.documentElement, { attributeFilter: ['data-theme'] });
    const darkQuery = matchMedia('(prefers-color-scheme: dark)');

    window.addEventListener('resize', onResize);
    document.addEventListener('visibilitychange', play);
    darkQuery.addEventListener('change', refresh);
    reduceMotion.addEventListener('change', play);

    // Leaving the homepage: stop the loop and drop every listener.
    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelAnimationFrame(raf);
        clearTimeout(resizeTimer);
        themeObserver.disconnect();
        window.removeEventListener('resize', onResize);
        document.removeEventListener('visibilitychange', play);
        darkQuery.removeEventListener('change', refresh);
        reduceMotion.removeEventListener('change', play);
      },
      { once: true }
    );

    refresh();
    root.classList.add('is-ready');
  };

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .ascii-bg {
    position: fixed;
    inset: 0;
    /* Behind all content, above the page background. */
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .ascii-bg.is-ready {
    opacity: 1;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .art {
    opacity: var(--ascii-opacity);
  }

  /* Twinkles are drawn at their own strength in JS (--ascii-twinkle-peak). */
  @media (prefers-reduced-motion: reduce) {
    .twinkle {
      display: none;
    }
  }
</style>
