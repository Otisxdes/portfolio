---
/* One row in a project list: status dot, title, outcome, metadata.
   Links to the case study when one exists. */
import type { Project } from '../data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const live = project.status === 'in-progress';
const Tag = project.hasCaseStudy ? 'a' : 'div';
---

<li data-reveal>
  <Tag
    class:list={['row', { linked: project.hasCaseStudy }]}
    href={project.hasCaseStudy ? `/work/${project.slug}` : undefined}
  >
    <span class="title">
      {project.title}
      {
        live && (
          <span class="status">
            <span class="pulse" aria-hidden="true" />
            <span class="label">In progress</span>
          </span>
        )
      }
    </span>
    <span class="outcome muted">{project.outcome}</span>
    <span class="meta label">{project.discipline} / {project.context} · {project.period}</span>
  </Tag>
</li>

<style>
  li {
    list-style: none;
  }

  .row {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4);
    text-decoration: none;
  }

  .title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: var(--weight-medium);
  }

  /* Linked rows: on hover (or keyboard focus) a rounded surface fades in
     behind the row, with light coming in from its right edge. Both layers
     are absolutely positioned and bleed a little past the text, so the row
     itself never changes size or moves. Colours: --row-* in tokens.css. */
  .linked {
    position: relative;
    isolation: isolate;
    --bleed: min(var(--space-4), calc(var(--gutter) - var(--space-1)));
  }
  .linked::before,
  .linked::after {
    content: '';
    position: absolute;
    inset: 0 calc(var(--bleed) * -1);
    z-index: -1;
    border-radius: var(--radius-lg);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-row) var(--ease-out),
      transform var(--duration-row) var(--ease-out);
  }
  /* The surface: a soft gradient with a hairline border. */
  .linked::before {
    background: linear-gradient(100deg, var(--row-surface-a), var(--row-surface-b));
    box-shadow:
      inset 0 0 0 1px var(--row-border),
      inset 0 1px 0 var(--row-border-top);
  }
  /* The light: a glow pooled at the right edge plus a thin bright seam
     right at the edge. It grows out from the right as it fades in. */
  .linked::after {
    background:
      radial-gradient(4px 42% at calc(100% - 1px) 50%, var(--row-edge), transparent),
      radial-gradient(38% 120% at 100% 50%, var(--row-glow), transparent 72%);
    transform: scaleX(0.6);
    transform-origin: right center;
  }
  .linked:hover::before,
  .linked:focus-visible::before {
    opacity: 1;
  }
  .linked:hover::after,
  .linked:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }
  .linked:focus-visible {
    outline: none;
  }
  .linked:focus-visible::before {
    box-shadow:
      inset 0 0 0 1px var(--color-focus),
      inset 0 1px 0 var(--row-border-top);
  }

  /* Linked rows: arrow appears and nudges on hover. */
  .linked .title::after {
    content: '→';
    margin-left: auto;
    color: var(--color-text-faint);
    transition: transform var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }
  .linked:hover .title::after,
  .linked:focus-visible .title::after {
    transform: translateX(3px);
    color: var(--color-text);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--weight-regular);
  }

  .pulse {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-live);
  }
  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-live);
    animation: pulse 2s var(--ease-out) infinite;
  }
  @keyframes pulse {
    from {
      transform: scale(1);
      opacity: 0.6;
    }
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse::after {
      animation: none;
    }
    .linked::after {
      transform: none;
    }
  }

  .meta {
    color: var(--color-text-faint);
  }
</style>
