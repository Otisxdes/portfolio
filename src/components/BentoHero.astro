---
/* Layered hero: the bento tiles, a looping phone-screen video sized to the
   mockup's screen, and the phone frame + hearts on top. Files:
     src/assets/projects/<slug>/bento-hero.*       tiles, transparent background, no phone
     src/assets/projects/<slug>/bento-overlay.png  phone frame with the screen cut out
     public/media/projects/<slug>/bento-phone-loop.webm / .mp4
     public/media/projects/<slug>/bento-phone-loop-poster.jpg  first frame
   Both images share the same canvas, so they line up exactly. The poster
   fills the screen before the video loads and for reduced motion. */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  alt: string;
  priority?: boolean;
}

const { slug, alt, priority = false } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/*/bento-{hero,overlay}.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);
const find = (name: string) =>
  Object.entries(images).find(([path]) => path.startsWith(`/src/assets/projects/${slug}/${name}.`))?.[1]
    .default;
const still = find('bento-hero');
const overlay = find('bento-overlay');
const video = `/media/projects/${slug}/bento-phone-loop`;

const sizes = '(min-width: 64rem) 64rem, 100vw';
const widthsFor = (src: ImageMetadata) => [...[800, 1200, 1600, 2400].filter((w) => w < src.width), src.width];
const loading = priority ? 'eager' : 'lazy';
---

{
  still && overlay && (
    <figure class="bento" style={`aspect-ratio: ${overlay.width} / ${overlay.height}`}>
      <Picture
        class="layer"
        src={still}
        alt={alt}
        formats={['avif', 'webp']}
        widths={widthsFor(still)}
        sizes={sizes}
        loading={loading}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
      <video
        data-bento-loop
        class="screen"
        muted
        loop
        playsinline
        preload="metadata"
        poster={`${video}-poster.jpg`}
        aria-hidden="true"
        tabindex="-1"
      >
        <source src={`${video}.webm`} type="video/webm" />
        <source src={`${video}.mp4`} type="video/mp4" />
      </video>
      <Picture
        class="layer"
        src={overlay}
        alt=""
        formats={['avif', 'webp']}
        widths={widthsFor(overlay)}
        sizes={sizes}
        loading={loading}
        decoding="async"
      />
    </figure>
  )
}

<script>
  // Play only while on screen; reduced-motion users keep the still.
  const setup = () => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) video.play().catch(() => {});
          else video.pause();
        }
      },
      { threshold: 0.1 }
    );
    document.querySelectorAll<HTMLVideoElement>('[data-bento-loop]').forEach((v) => observer.observe(v));
  };
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .bento {
    position: relative;
    margin: 0;
    width: 100%;
  }
  .bento :global(.layer) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* Screen opening measured from the Figma frame (1440×1024):
     x 556, y 156.33, w 328, h 712.33, corner radius 50. */
  .screen {
    position: absolute;
    left: 38.6111%;
    top: 15.2669%;
    width: 22.7778%;
    height: 69.5638%;
    object-fit: fill;
    border-radius: 15.264% / 7.029%;
    background: #fff;
  }
</style>
