---
/* Header: clock + nav + theme toggle. `transition:persist` keeps it (and
   the ticking clock) alive across page transitions instead of re-rendering.

   Two small LED details, in the ornaments' colours (--led-* tokens):
   - Nav marker: a lit diamond tile under the current page's link. It slides
     to the new link when the page changes.
   - Scroll tiles: a row of tiles along the header's bottom edge that light
     up from the left as you scroll down. Hidden on pages too short to need
     it. Decorative only (hidden from screen readers). */
import { nav, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import OrnamentMark from './OrnamentMark.astro';
---

<header class="header" transition:persist="site-header">
  <div class="inner">
    <a href="/" class="name" aria-label={`${site.name}, home`}>
      <OrnamentMark />
      {site.shortName}
    </a>

    <p class="clock label" aria-label={`Local time in ${site.location.city}`}>
      <time data-clock data-tz={site.location.timeZone}>--:--:--</time>
      <span class="zone">({site.location.zoneLabel})</span>
    </p>

    <nav aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav-mark" data-nav-mark aria-hidden="true"></li>
      </ul>
    </nav>

    <ThemeToggle />
  </div>
  <div class="scroll-tiles" data-scroll-tiles aria-hidden="true"><span></span></div>
</header>

<script>
  /* Live clock in the site owner's timezone. */
  const el = document.querySelector<HTMLTimeElement>('[data-clock]');
  if (el) {
    const fmt = new Intl.DateTimeFormat('en-US', {
      timeZone: el.dataset.tz,
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: true,
    });
    const tick = () => {
      const now = new Date();
      el.textContent = fmt.format(now);
      el.dateTime = now.toISOString();
    };
    tick();
    setInterval(tick, 1000);
  }

  /* The header persists across pages, so the "current page" marker has to
     be updated by script after each navigation. */
  const mark = document.querySelector<HTMLElement>('[data-nav-mark]');
  // Slide the diamond under the current link (or hide it if there is none).
  const placeMark = () => {
    if (!mark) return;
    const current = document.querySelector<HTMLAnchorElement>('[data-nav-link][aria-current]');
    if (!current) {
      mark.classList.remove('is-on');
      return;
    }
    mark.style.setProperty('--x', `${current.offsetLeft + current.offsetWidth / 2}px`);
    // First placement: appear in place instead of sliding in from the left.
    if (!mark.classList.contains('is-on')) {
      mark.style.transition = 'none';
      void mark.offsetWidth;
      mark.style.transition = '';
    }
    mark.classList.add('is-on');
  };
  const markCurrent = () => {
    const path = location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((a) => {
      const href = a.getAttribute('href') ?? '';
      const isCurrent = href === '/' ? path === '/' : path.startsWith(href);
      if (isCurrent) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
    placeMark();
  };
  document.addEventListener('astro:page-load', markCurrent);
  window.addEventListener('resize', placeMark);
  // Link widths change once the web font arrives.
  document.fonts?.ready.then(placeMark);

  /* Scroll tiles: how far down the page you are, as lit tiles. The lit
     length snaps to whole tiles, so it steps like an LED strip. */
  const tiles = document.querySelector<HTMLElement>('[data-scroll-tiles]');
  if (tiles) {
    const TILE = 4; // css px per tile, including its gap (matches the CSS)
    const MIN_SCROLL = 500; // css px: shorter pages get no strip
    let queued = false;
    const update = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      tiles.classList.toggle('is-on', max > MIN_SCROLL);
      const share = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      const lit = Math.round((share * tiles.clientWidth) / TILE) * TILE;
      tiles.style.setProperty('--lit', `${lit}px`);
    };
    const request = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    document.addEventListener('astro:page-load', request);
    // Images loading in make the page taller.
    new ResizeObserver(request).observe(document.body);
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 35%, transparent);
    backdrop-filter: blur(8px) saturate(1.4);
  }
  /* Older Safari only knows the prefixed property. It lives in its own
     block because the CSS minifier merges two equivalent declarations in
     one rule and keeps just one of them, which dropped the blur in Chrome
     on the live site. */
  @supports (-webkit-backdrop-filter: none) {
    .header {
      -webkit-backdrop-filter: blur(8px) saturate(1.4);
    }
  }

  .inner {
    max-width: calc(var(--measure) + var(--gutter) * 2);
    margin-inline: auto;
    padding: var(--space-4) var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .name {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .clock {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .zone {
    color: var(--color-text-faint);
    margin-left: 0.4em;
  }

  nav {
    margin-left: auto;
  }
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: var(--space-4);
  }
  nav a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-text);
  }
  nav a {
    transition: color var(--duration-base) var(--ease-out);
  }

  /* The diamond under the current link: one tile, turned 45°. */
  nav ul {
    position: relative;
  }
  .nav-mark {
    position: absolute;
    left: 0;
    bottom: -7px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    background: var(--led-lit);
    box-shadow: 0 0 calc(var(--led-glow) * 6px) var(--led-lit);
    opacity: 0;
    transform: translateX(var(--x, 0)) rotate(45deg) scale(0.4);
    transition: transform 520ms var(--ease-out),
      opacity var(--duration-base) var(--ease-out);
    pointer-events: none;
  }
  .nav-mark.is-on {
    opacity: 1;
    transform: translateX(var(--x, 0)) rotate(45deg) scale(1);
  }

  /* Scroll tiles. Two layers of the same tile pattern: the whole strip at
     rest, and the lit share on top (its width is set by the script). */
  .scroll-tiles {
    --tile: 3px;
    --pitch: 4px; /* tile + gap */
    position: absolute;
    left: 50%;
    bottom: 0;
    width: min(var(--measure), 100% - var(--gutter) * 2);
    /* A whole number of tiles, so the strip never ends on a cut one. */
    width: round(down, min(var(--measure), 100% - var(--gutter) * 2), var(--pitch));
    height: var(--tile);
    transform: translateX(-50%);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
    pointer-events: none;
  }
  .scroll-tiles.is-on {
    opacity: 1;
  }
  .scroll-tiles::before,
  .scroll-tiles span {
    content: '';
    position: absolute;
    inset: 0;
    -webkit-mask: repeating-linear-gradient(90deg, #000 0 var(--tile), transparent var(--tile) var(--pitch));
    mask: repeating-linear-gradient(90deg, #000 0 var(--tile), transparent var(--tile) var(--pitch));
  }
  .scroll-tiles::before {
    background: var(--led-off);
    opacity: var(--led-off-alpha);
  }
  .scroll-tiles span {
    background: var(--led-lit);
    opacity: var(--led-lit-alpha);
    clip-path: inset(-6px calc(100% - var(--lit, 0px)) -6px 0);
    transition: clip-path 160ms steps(4, end);
  }

  /* Mobile: the clock drops to its own line under the name. */
  @media (max-width: 34rem) {
    .inner {
      flex-wrap: wrap;
      row-gap: var(--space-1);
    }
    .clock {
      order: 3;
      width: 100%;
    }
    ul {
      gap: var(--space-3);
    }
  }
</style>
