---
/* Optimised image. Put the source file in src/assets/… and import it —
   Astro resizes it and serves AVIF/WebP with the right srcset at build time.

   Usage:
     import hero from '../assets/projects/shukran-credit-card/hero.png';
     <Media src={hero} alt="Landing page hero on desktop" />
*/
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** Describe what the image shows. Use "" only for purely decorative images. */
  alt: string;
  caption?: string;
  /** Load immediately (use for the first image on a page). */
  priority?: boolean;
  /** How wide the image renders, so the browser picks the right file. */
  sizes?: string;
  /** No background or rounded corners — for transparent cut-outs (mockups, diagrams). */
  plain?: boolean;
  /** Serve the original file untouched (no resizing or recompression).
      For diagrams and line art, where recompression blurs thin lines. */
  crisp?: boolean;
  class?: string;
}

const {
  src,
  alt,
  caption,
  priority = false,
  sizes = '(min-width: 64rem) 64rem, 100vw',
  plain = false,
  crisp = false,
  class: className,
} = Astro.props;

// Smaller sizes for small screens, plus the original width so large
// displays never get a stretched-up image.
const widths = [...[480, 800, 1200, 1600, 2400].filter((w) => w < src.width), src.width];
---

<figure class:list={['media', { plain }, className]}>
  {
    crisp ? (
      <img
        src={src.src}
        width={src.width}
        height={src.height}
        alt={alt}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    )
  }
  {caption && <figcaption class="label">{caption}</figcaption>}
</figure>

<style>
  .media {
    display: grid;
    gap: var(--space-2);
  }
  .media :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .plain :global(img) {
    border-radius: 0;
    background: none;
  }
  figcaption {
    color: var(--color-text-faint);
  }
</style>
