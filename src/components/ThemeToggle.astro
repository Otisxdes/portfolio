---
/* Light/dark toggle. Default follows the system; a click saves an explicit
   choice. The label names the theme you'll switch TO.
   The new theme is revealed through a diamond growing from the button
   (styles: "Theme switch" in global.css). */
---

<button class="toggle label" type="button" data-theme-toggle aria-label="Switch theme">
  <span class="dot" aria-hidden="true"></span>
</button>

<script>
  const isDark = () => {
    const set = document.documentElement.dataset.theme;
    if (set) return set === 'dark';
    return matchMedia('(prefers-color-scheme: dark)').matches;
  };

  const update = (btn: HTMLButtonElement) => {
    const next = isDark() ? 'light' : 'dark';
    btn.setAttribute('aria-label', `Switch to ${next} theme`);
    btn.title = `Switch to ${next} theme`;
  };

  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (btn) {
    update(btn);
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const DURATION = 650; // ms the diamond takes to cover the screen
    btn.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      const root = document.documentElement;
      const apply = () => {
        root.dataset.theme = next;
        update(btn);
      };
      try {
        localStorage.setItem('theme', next);
      } catch (e) {
        /* storage unavailable; theme still applies for this visit */
      }
      if (!document.startViewTransition || reduceMotion.matches) {
        apply();
        return;
      }
      root.classList.add('theme-switch');
      const transition = document.startViewTransition(apply);
      transition.ready
        .then(() => {
          // The diamond grows from the centre of the button until it just
          // covers the farthest corner of the screen (no overshoot, so the
          // edge moves at an even pace the whole way).
          const r = btn.getBoundingClientRect();
          const x = r.left + r.width / 2;
          const y = r.top + r.height / 2;
          const reach =
            Math.max(x, window.innerWidth - x) + Math.max(y, window.innerHeight - y);
          const diamond = (d: number) =>
            `polygon(${x}px ${y - d}px, ${x + d}px ${y}px, ${x}px ${y + d}px, ${x - d}px ${y}px)`;
          root.animate(
            { clipPath: [diamond(0), diamond(reach)] },
            {
              duration: DURATION,
              easing: 'cubic-bezier(0.45, 0, 0.25, 1)',
              fill: 'both',
              pseudoElement: '::view-transition-new(root)',
            },
          );
        })
        // If the browser skips the animation (e.g. the tab is in the
        // background), the theme has still switched: nothing to report.
        .catch(() => {});
      transition.finished.catch(() => {}).finally(() => root.classList.remove('theme-switch'));
    });
  }
</script>

<style>
  .toggle {
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
  }
  .dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-text);
    /* Half-filled circle: reads as "theme" without an icon library. */
    background: linear-gradient(90deg, var(--color-text) 50%, transparent 50%);
    transition: transform var(--duration-base) var(--ease-out);
  }
  .toggle:hover .dot {
    transform: rotate(180deg);
  }
</style>
