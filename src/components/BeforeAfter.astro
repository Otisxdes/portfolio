---
/* Before / after slider. The After image sits underneath; Before is clipped
   on top, so left of the divider = Before.
   - Sweeps on its own while on screen: hold Before → sweep → hold After → back.
   - Drag or use the arrow keys to compare; the sweep resumes after 3.5s idle,
     from wherever the divider was left.
   - Reduced motion: no sweep, starts at the halfway point.
   Both images must share the same size and framing. */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  /** What is being compared, e.g. "Babyshop product listing page". */
  label: string;
  sizes?: string;
}

const { before, after, label, sizes = '(min-width: 64rem) 64rem, 100vw' } = Astro.props;
const widthsFor = (src: ImageMetadata) => [...[800, 1200, 1600, 2400].filter((w) => w < src.width), src.width];
---

<div
  class="ba"
  data-before-after
  role="slider"
  tabindex="0"
  aria-label={`${label}, before and after the rebrand`}
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  aria-valuetext="Showing before"
  style={`aspect-ratio: ${after.width} / ${after.height}`}
>
  <Picture
    class="img"
    src={after}
    alt={`${label} after the rebrand`}
    formats={['avif', 'webp']}
    widths={widthsFor(after)}
    sizes={sizes}
    loading="lazy"
    decoding="async"
    draggable="false"
  />
  <Picture
    class="img before"
    src={before}
    alt={`${label} before the rebrand`}
    formats={['avif', 'webp']}
    widths={widthsFor(before)}
    sizes={sizes}
    loading="lazy"
    decoding="async"
    draggable="false"
  />
  <span class="tag tag-before label" aria-hidden="true">Before</span>
  <span class="tag tag-after label" aria-hidden="true">After</span>
  <div class="line" aria-hidden="true"></div>
  <div class="knob" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8.5 7 3.5 12l5 5M15.5 7l5 5-5 5"></path>
    </svg>
  </div>
</div>

<script>
  // Timeline in seconds: hold Before → sweep to After → hold After → sweep back.
  const HOLD_BEFORE = 1.2;
  const SWEEP = 2.6;
  const HOLD_AFTER = 1.8;
  const PERIOD = HOLD_BEFORE + SWEEP + HOLD_AFTER + SWEEP;
  const RESUME_AFTER_MS = 3500;

  const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);

  // Divider position (100 = all Before, 0 = all After) at time t on the loop.
  const sweepAt = (t: number) => {
    t = ((t % PERIOD) + PERIOD) % PERIOD;
    if (t < HOLD_BEFORE) return 100;
    t -= HOLD_BEFORE;
    if (t < SWEEP) return 100 - 100 * ease(t / SWEEP);
    t -= SWEEP;
    if (t < HOLD_AFTER) return 0;
    t -= HOLD_AFTER;
    return 100 * ease(t / SWEEP);
  };

  // The time on the Before → After leg that matches position p, so the sweep
  // resumes without a jump. Inverts the easing by bisection.
  const resumeTime = (p: number) => {
    const target = 1 - p / 100;
    let lo = 0;
    let hi = 1;
    for (let i = 0; i < 24; i++) {
      const mid = (lo + hi) / 2;
      if (ease(mid) < target) lo = mid;
      else hi = mid;
    }
    return HOLD_BEFORE + lo * SWEEP;
  };

  const setup = (el: HTMLElement) => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let p = 100;
    let auto = false;
    let dragging = false;
    let idle = false;
    let t0 = 0;
    let raf = 0;
    let idleTimer = 0;

    const setP = (v: number) => {
      p = Math.max(0, Math.min(100, v));
      el.style.setProperty('--p', `${p}%`);
      // Handle fades out near either edge.
      el.style.setProperty('--o', String(Math.max(0, Math.min(1, Math.min(p, 100 - p) / 5))));
      const shown = Math.round(100 - p);
      el.setAttribute('aria-valuenow', String(shown));
      el.setAttribute(
        'aria-valuetext',
        shown === 0 ? 'Showing before' : shown === 100 ? 'Showing after' : `${shown}% after`
      );
      el.classList.toggle('hide-before', p < 14);
      el.classList.toggle('hide-after', p > 86);
    };

    const tick = (now: number) => {
      if (!auto) return;
      setP(sweepAt((now - t0) / 1000));
      raf = requestAnimationFrame(tick);
    };
    const startAuto = () => {
      if (reduce || auto) return;
      auto = true;
      idle = false;
      t0 = performance.now() - resumeTime(p) * 1000;
      raf = requestAnimationFrame(tick);
    };
    const stopAuto = () => {
      auto = false;
      cancelAnimationFrame(raf);
      clearTimeout(idleTimer);
    };
    const scheduleResume = () => {
      idle = true;
      clearTimeout(idleTimer);
      idleTimer = window.setTimeout(startAuto, RESUME_AFTER_MS);
    };

    // Drag.
    const fromEvent = (e: PointerEvent) => {
      const r = el.getBoundingClientRect();
      return ((e.clientX - r.left) / r.width) * 100;
    };
    el.addEventListener('pointerdown', (e) => {
      dragging = true;
      stopAuto();
      el.classList.add('drag');
      el.setPointerCapture(e.pointerId);
      setP(fromEvent(e));
    });
    el.addEventListener('pointermove', (e) => {
      if (dragging) setP(fromEvent(e));
    });
    const end = () => {
      if (!dragging) return;
      dragging = false;
      el.classList.remove('drag');
      scheduleResume();
    };
    el.addEventListener('pointerup', end);
    el.addEventListener('pointercancel', end);

    // Keyboard: arrows step (Shift = bigger steps), Home = After, End = Before.
    el.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 10 : 3;
      if (e.key === 'ArrowLeft') setP(p - step);
      else if (e.key === 'ArrowRight') setP(p + step);
      else if (e.key === 'Home') setP(0);
      else if (e.key === 'End') setP(100);
      else return;
      e.preventDefault();
      stopAuto();
      scheduleResume();
    });

    // Sweep only while on screen.
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !dragging && !idle) startAuto();
        if (!entry.isIntersecting) stopAuto();
      },
      { threshold: 0.25 }
    ).observe(el);

    setP(reduce ? 50 : 100);
  };

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-before-after]').forEach(setup);
  });
</script>

<style>
  .ba {
    --p: 100%;
    --o: 1;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    cursor: ew-resize;
    touch-action: pan-y; /* vertical scroll still works on touch */
    user-select: none;
    -webkit-user-select: none;
  }
  .ba:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
  .ba :global(.img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .ba :global(.before) {
    clip-path: inset(0 calc(100% - var(--p)) 0 0);
  }

  .line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--p);
    width: 2px;
    margin-left: -1px;
    background: var(--color-stage-strong);
    box-shadow: 0 0 16px rgb(0 0 0 / 0.2);
    opacity: var(--o);
  }
  .knob {
    position: absolute;
    top: 50%;
    left: var(--p);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin: -1.5rem 0 0 -1.5rem;
    border-radius: 50%;
    background: var(--color-stage-strong);
    color: var(--color-stage);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.2);
    opacity: var(--o);
    transition: transform var(--duration-base) var(--ease-out);
  }
  .drag .knob {
    transform: scale(1.1);
  }
  .knob svg {
    width: 1.375rem;
    height: 1.375rem;
  }

  .tag {
    position: absolute;
    top: var(--space-4);
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    background: var(--color-stage);
    color: var(--color-stage-strong);
    pointer-events: none;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }
  .tag-before {
    left: var(--space-4);
  }
  .tag-after {
    right: var(--space-4);
  }
  /* Fade a label when the divider is about to cover it. */
  .hide-before .tag-before,
  .hide-after .tag-after {
    opacity: 0;
    transform: translateY(-4px);
  }

  @media (max-width: 40rem) {
    .knob {
      width: 2.5rem;
      height: 2.5rem;
      margin: -1.25rem 0 0 -1.25rem;
    }
    .tag {
      top: var(--space-2);
    }
    .tag-before {
      left: var(--space-2);
    }
    .tag-after {
      right: var(--space-2);
    }
  }
</style>
