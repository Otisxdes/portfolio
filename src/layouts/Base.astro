---
/* Base layout: every page is wrapped in this. Handles <head>, theme,
   page transitions, smooth scroll and the header/footer shell. */
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { person } from '../data/structured-data';
import portrait from '../assets/site/portrait.webp';
import '../styles/global.css';

/** Share preview image (link cards on LinkedIn, Slack, WhatsApp, X…). */
export interface ShareImage {
  /** Root-relative path, e.g. /media/projects/<slug>/<file>.jpg */
  src: string;
  width: number;
  height: number;
  alt: string;
}

interface Props {
  title?: string;
  description?: string;
  /** Defaults to the portrait (square card). */
  image?: ShareImage;
  /** 'article' for case studies. */
  type?: 'website' | 'article';
  /** Keep this page out of search results (it stays reachable by link). */
  noindex?: boolean;
  /** Page-specific Schema.org data, added to the site-wide Person. */
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  type = 'website',
  noindex = false,
  structuredData = [],
} = Astro.props;

// Fallback share image: the portrait, as a square JPEG (widest support).
const portraitShare = await getImage({ src: portrait, width: 1200, height: 1200, format: 'jpg' });
const image: ShareImage = Astro.props.image ?? {
  src: portraitShare.src,
  width: 1200,
  height: 1200,
  alt: `Portrait of ${site.name}`,
};
const imageUrl = new URL(image.src, site.url).href;
const isWide = image.width / image.height > 1.5;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...person(new URL(portraitShare.src, site.url).href), ...structuredData],
};
const pageTitle = title ? `${title} · ${site.name}` : `${site.name}, ${site.role}`;
// Canonical URL: no trailing slash and no .html, matching how pages are linked and served.
const path =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/(^|\/)index$/, '$1')
    .replace(/\/$/, '') || '/';
const canonical = new URL(path, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content={isWide ? 'summary_large_image' : 'summary'} />

    <!-- Structured data: who this site is about (and, on case studies, the article). -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Theme: runs before paint so there's no flash of the wrong theme.
         Re-applied after each page swap because the router replaces <html> attributes. -->
    <script is:inline>
      (() => {
        const apply = () => {
          let saved = null;
          try { saved = localStorage.getItem('theme'); } catch (e) {}
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
          // Flag that reveal animations will run, so [data-reveal] starts hidden
          // without a flicker. Skipped for reduced-motion users.
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('js-motion');
          }
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    <!-- Analytics: Umami, cookieless (no consent banner needed). data-domains
         limits counting to the live site, so local testing isn't recorded.
         It follows page transitions on its own. Events are marked in the
         markup with data-umami-event="name". -->
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="11b1691b-b5cb-43b5-ac0f-eec8a1f8cd7e"
      data-domains="www.otisxdes.com"></script>

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/smooth-scroll';
      import '../scripts/reveal';
      import '../scripts/count-up';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: -3rem;
    padding: var(--space-2) var(--space-3);
    background: var(--color-text);
    color: var(--color-bg);
    border-radius: var(--radius-sm);
    z-index: 100;
    text-decoration: none;
  }
  .skip-link:focus {
    top: var(--space-3);
  }

  main {
    flex: 1; /* fills short pages, so the footer sits at the bottom */
    width: 100%;
    max-width: calc(var(--measure) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-8) var(--space-9);
  }
</style>
