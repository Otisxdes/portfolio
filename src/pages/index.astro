---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectRow from '../components/ProjectRow.astro';
import LedOrnaments from '../components/LedOrnaments.astro';
import EmailCopy from '../components/EmailCopy.astro';
import RowPreviews from '../components/RowPreviews.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/site/portrait.avif';
import { projects, experience, socials, site } from '../data/site';
---

<Base>
  <LedOrnaments />
  <RowPreviews />

  <div class="intro" data-reveal-group>
    <!-- The frame draws four stepped tile corners around the photo. -->
    <span class="portrait-frame" data-reveal>
      <Image
        class="portrait"
        src={portrait}
        alt={site.name}
        width={72}
        height={72}
        densities={[1, 2, 3]}
        loading="eager"
      />
    </span>

    <p class="lead" data-reveal>
      I'm Otabek, a product designer who defines the real problem first, then designs for revenue and
      conversion.
    </p>

    <p data-reveal>
      Currently at Landmark Group, designing across the{' '}
      <a href="/work/shukran-credit-card">Shukran loyalty programme</a> and e-commerce for Homecentre,
      Babyshop and Splash. Right now I'm redesigning the returns journey.
    </p>

    <p data-reveal>
      I hand the routine to AI (research, iterations, first drafts of copy), so more of my time goes
      where human judgment matters.
    </p>

    <p class="muted" data-reveal>Based in {site.location.city}, {site.location.country}.</p>
  </div>

  <Section label="work">
    <ul class="rows" data-reveal-group>
      {projects.map((project) => <ProjectRow project={project} />)}
    </ul>
  </Section>

  <Section label="experience">
    <ul class="rows" data-reveal-group>
      {
        experience.map((job) => (
          <li class="job" data-reveal>
            <div class="job-row">
              <span>{job.org}</span>
              <span class="muted">{job.role}</span>
              {job.period && <span class="label period">{job.period}</span>}
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section label="contact">
    <div class="contact" data-reveal-group>
      <p data-reveal>
        Hiring for a product design role, or building something that needs a careful eye?
      </p>
      <p data-reveal>
        Email me at <EmailCopy email={site.email} />
      </p>
      <p class="muted" data-reveal>
        Elsewhere:{' '}
        {
          socials.map((s, i) => (
            <>
              <a href={s.href} rel="me noopener" target="_blank">
                {s.label}
              </a>
              {i < socials.length - 1 ? ', ' : '.'}
            </>
          ))
        }
      </p>
    </div>
  </Section>
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--space-4);
  }

  /* Square photo: 72px on desktop, 56px on mobile. The intro's own gap
     (--space-4, 16px) sets the spacing to the first line. */
  .intro :global(.portrait) {
    width: var(--size);
    height: var(--size);
    border-radius: var(--radius-portrait);
    object-fit: cover;
  }

  /* Tile corners around the photo: three LED tiles per corner, stepped like
     the ornaments' corners. They rest faint and light up on hover, one
     diagonal pair a beat after the other. Each pseudo-element is a single
     tile; its box-shadows draw the other tiles of its two corners. */
  .portrait-frame {
    --size: 72px;
    --t: 3px; /* tile */
    --p: 4px; /* tile + gap */
    --out: 7px; /* how far outside the photo the corners sit */
    --far: calc(var(--size) + var(--out) * 2 - var(--t)); /* to the opposite corner */
    position: relative;
    justify-self: start;
    display: block;
    width: var(--size);
    height: var(--size);
  }
  .portrait-frame::before,
  .portrait-frame::after {
    content: '';
    position: absolute;
    top: calc(var(--out) * -1);
    width: var(--t);
    height: var(--t);
    color: var(--led-off);
    background: currentColor;
    opacity: var(--led-off-alpha);
    transition: color var(--duration-row) var(--ease-out),
      opacity var(--duration-row) var(--ease-out),
      filter var(--duration-row) var(--ease-out);
  }
  /* Top-left corner, and (through the shadows) bottom-right. */
  .portrait-frame::before {
    left: calc(var(--out) * -1);
    box-shadow:
      var(--p) 0 currentColor,
      0 var(--p) currentColor,
      var(--far) var(--far) currentColor,
      calc(var(--far) - var(--p)) var(--far) currentColor,
      var(--far) calc(var(--far) - var(--p)) currentColor;
  }
  /* Top-right corner, and bottom-left. */
  .portrait-frame::after {
    right: calc(var(--out) * -1);
    box-shadow:
      calc(var(--p) * -1) 0 currentColor,
      0 var(--p) currentColor,
      calc(var(--far) * -1) var(--far) currentColor,
      calc(var(--p) - var(--far)) var(--far) currentColor,
      calc(var(--far) * -1) calc(var(--far) - var(--p)) currentColor;
    transition-delay: 90ms;
  }
  .portrait-frame:hover::before,
  .portrait-frame:hover::after {
    color: var(--led-lit);
    opacity: var(--led-lit-alpha);
    filter: drop-shadow(0 0 calc(var(--led-glow) * 4px) var(--led-lit));
  }
  @media (max-width: 34rem) {
    .portrait-frame {
      --size: 56px;
    }
  }

  .lead {
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    font-weight: var(--weight-medium);
  }

  .rows {
    padding: 0;
  }

  .job {
    list-style: none;
  }
  .job-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 var(--space-4);
    padding-block: var(--space-3);
  }
  .job-row .period {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--color-text-faint);
  }

  .contact {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }
</style>
