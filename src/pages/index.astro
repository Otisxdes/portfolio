---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectRow from '../components/ProjectRow.astro';
import LedOrnaments from '../components/LedOrnaments.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/site/portrait.avif';
import { projects, experience, socials, site } from '../data/site';
---

<Base>
  <LedOrnaments />

  <div class="intro" data-reveal-group>
    <Image
      class="portrait"
      src={portrait}
      alt={site.name}
      width={72}
      height={72}
      densities={[1, 2, 3]}
      loading="eager"
      data-reveal
    />

    <p class="lead" data-reveal>
      I'm Otabek, a product designer who defines the real problem first, then designs for revenue and
      conversion.
    </p>

    <p data-reveal>
      Currently at Landmark Group, designing across the{' '}
      <a href="/work/shukran-credit-card">Shukran loyalty programme</a> and e-commerce for Homecentre,
      Babyshop and Splash. Right now I'm redesigning the returns journey.
    </p>

    <p data-reveal>
      I hand the routine to AI (research, iterations, first drafts of copy), so more of my time goes
      where human judgment matters.
    </p>

    <p class="muted" data-reveal>Based in {site.location.city}, {site.location.country}.</p>
  </div>

  <Section label="work">
    <ul class="rows" data-reveal-group>
      {projects.map((project) => <ProjectRow project={project} />)}
    </ul>
  </Section>

  <Section label="experience">
    <ul class="rows" data-reveal-group>
      {
        experience.map((job) => (
          <li class="job" data-reveal>
            <div class="job-row">
              <span>{job.org}</span>
              <span class="muted">{job.role}</span>
              {job.period && <span class="label period">{job.period}</span>}
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section label="contact">
    <div class="contact" data-reveal-group>
      <p data-reveal>
        Hiring for a product design role, or building something that needs a careful eye?{' '}
        <a href={`mailto:${site.email}`}>Email me</a>.
      </p>
      <p class="muted" data-reveal>
        Elsewhere:{' '}
        {
          socials.map((s, i) => (
            <>
              <a href={s.href} rel="me noopener" target="_blank">
                {s.label}
              </a>
              {i < socials.length - 1 ? ', ' : '.'}
            </>
          ))
        }
      </p>
    </div>
  </Section>
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--space-4);
  }

  /* Square photo: 72px on desktop, 56px on mobile. The intro's own gap
     (--space-4, 16px) sets the spacing to the first line. */
  .intro :global(.portrait) {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-portrait);
    object-fit: cover;
  }
  @media (max-width: 34rem) {
    .intro :global(.portrait) {
      width: 56px;
      height: 56px;
    }
  }

  .lead {
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    font-weight: var(--weight-medium);
  }

  .rows {
    padding: 0;
  }

  .job {
    list-style: none;
  }
  .job-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 var(--space-4);
    padding-block: var(--space-3);
  }
  .job-row .period {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--color-text-faint);
  }

  .contact {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }
</style>
